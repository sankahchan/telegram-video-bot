# Copy this file to .env and fill in your values:
#   cp .env.example .env
# NEVER commit .env to GitHub.

API_ID=
API_HASH=
BOT_TOKEN=
SESSION_STRING=
ALLOWED_USER_IDS=
# Parallel download connections (default 8, max ~16)
DOWNLOAD_WORKERS=8

# --- v5.4.0 extras (all optional) ---------------------------------------
# YouTube PO-token provider (bgutil server) — fixes YouTube "not a bot" blocks
# on VPS IPs. Leave empty to skip.
#   docker run --name bgutil-provider -d --init -p 127.0.0.1:4416:4416 \
#     brainicism/bgutil-ytdlp-pot-provider
POT_PROVIDER_URL=http://127.0.0.1:4416
# Paid residential proxy for yt-dlp (durable YouTube fallback, optional)
# e.g. YTDLP_PROXY=socks5://user:pass@host:port
YTDLP_PROXY=
# YouTube fallback chain (v6.3.0): when yt-dlp is bot-walled, the bot tries
# Cobalt -> Piped -> Invidious automatically. Piped/Invidious need no setup.
# Cobalt only (optional): self-hosted instance, e.g. http://127.0.0.1:9000/
#   docker run -d --name cobalt -p 127.0.0.1:9000:9000 ghcr.io/imput/cobalt:latest
COBALT_API_URL=
COBALT_API_KEY=
